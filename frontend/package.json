{
  "name": "moviepilot-plugins-repair-shop-vue",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:library && npm run build:remove && npm run normalize",
    "build:library": "PLUGIN_TARGET=library npm run build:remote",
    "build:remove": "PLUGIN_TARGET=remove npm run build:remote",
    "build:remote": "vite build",
    "normalize": "node scripts/normalize-federation-output.mjs"
  },
  "dependencies": {
    "@originjs/vite-plugin-federation": "^1.4.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "vite": "^6.1.0",
    "vue": "^3.5.13",
    "vuetify": "^3.7.15"
  },
  "devDependencies": {}
}
